# Copy to .env.local for local dev, and set the same vars in your host
# (e.g. Netlify → Site configuration → Environment variables) for deploys.
#
# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time, so it must be
# present when `next build` runs.

# Required. InstantDB app id (safe to expose — it ships to the browser).
NEXT_PUBLIC_INSTANT_APP_ID=your-instantdb-app-id

# Server-only admin token. Keep secret. Not used by the client yet (reserved for
# future server-side / sharing features).
INSTANT_ADMIN_TOKEN=your-instantdb-admin-token
